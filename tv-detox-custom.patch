diff --git a/install.sh b/install.sh
index e4830b4..2478dc0 100755
--- a/install.sh
+++ b/install.sh
@@ -35,6 +35,16 @@ case "$state" in
   *) echo "Can't reach $TV. Check the TV is on, on the same Wi-Fi, and has USB/network debugging turned on." >&2; exit 1 ;;
 esac
 
+# Remember the TV's own home screen, before this one is installed and only the first time, so undo.sh
+# can make it the default again. ("android/..." is Android asking which home to use: nothing to keep.)
+ORIGINAL=/data/local/tmp/tvhome-original-home.txt
+first_home=$(adb -s "$TV" shell cmd package resolve-activity --brief -a android.intent.action.MAIN \
+  -c android.intent.category.HOME 2>/dev/null | tr -d '\r' | tail -1) || first_home=
+case "$first_home" in
+  com.ansub.tvhome/*|android/*) ;;
+  */*) adb -s "$TV" shell "[ -e $ORIGINAL ] || echo $first_home > $ORIGINAL" || true ;;
+esac
+
 APK=out/tvhome.apk
 if [ ! -f "$APK" ]; then
   APK=$(mktemp -d)/tvhome.apk
@@ -102,6 +112,19 @@ home_opens_me() {
   return 1
 }
 
+# Screen saver: instead of going dark without warning, the screen fades to black over 30 seconds
+# (FadeDream) at the TV's screen saver time, then the TV sleeps. Any key in between brings it back.
+# The TV's own settings are saved first, only the first time, so undo.sh can put them back.
+DREAM=/data/local/tmp/tvhome-dream.txt
+sh_tv "[ -e $DREAM ] || for k in secure/screensaver_enabled secure/screensaver_components secure/screensaver_activate_on_sleep secure/sleep_timeout; do echo \$k \$(settings get \${k%/*} \${k#*/}); done > $DREAM" || true
+off=$(sh_tv settings get system screen_off_timeout) || off=
+sh_tv "settings put secure screensaver_enabled 1; settings put secure screensaver_activate_on_sleep 1; settings put secure screensaver_components com.ansub.tvhome/.FadeDream" || true
+# Sleep 30 seconds after the screen saver starts, unless the TV is set to never sleep.
+case "$off" in
+  ''|*[!0-9]*) ;;
+  *) [ "$(sh_tv settings get secure sleep_timeout)" = -1 ] || sh_tv settings put secure sleep_timeout $((off + 30000)) || true ;;
+esac
+
 # Make it the default home: the role (Android 10+) and the classic way.
 if [ "$(sh_tv getprop ro.build.version.sdk)" -ge 29 ]; then
   sh_tv cmd role add-role-holder --user 0 android.app.role.HOME com.ansub.tvhome >/dev/null 2>&1 || true
diff --git a/src/com/ansub/tvhome/FadeDream.java b/src/com/ansub/tvhome/FadeDream.java
