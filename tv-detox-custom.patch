diff --git a/build-win.sh b/build-win.sh
new file mode 100644
index 0000000..6e4733e
--- /dev/null
+++ b/build-win.sh
@@ -0,0 +1,40 @@
+#!/bin/sh
+# Builds out/tvhome.apk on Windows (Git Bash), where build.sh can't run: it needs zip and the Unix
+# d8/apksigner scripts. Needs Android Studio (for its Java) or JAVA_HOME, the Android SDK with any
+# platform and build-tools, and Python (the "py" launcher) to add classes.dex to the APK.
+#   sh build-win.sh            (from this folder)
+set -e
+cd "$(dirname "$0")"
+
+[ -n "$JAVA_HOME" ] || for j in "/c/Program Files/Android/Android Studio/jbr" "/c/Program Files/Android/Android Studio/jre"; do
+  [ -x "$j/bin/javac.exe" ] && JAVA_HOME=$j && break; done
+[ -n "$JAVA_HOME" ] || { echo "Java not found. Install Android Studio or set JAVA_HOME." >&2; exit 1; }
+export PATH="$JAVA_HOME/bin:$PATH"
+SDK=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$(cygpath -u "$LOCALAPPDATA")/Android/Sdk}}
+BT=$(ls -d "$SDK"/build-tools/*/ 2>/dev/null | sort -V | tail -1); BT=${BT%/}
+JAR=$(ls "$SDK"/platforms/android-*/android.jar 2>/dev/null | sort -V | tail -1)
+[ -n "$BT" ] && [ -f "$JAR" ] || { echo "Android SDK not found at $SDK. Set ANDROID_HOME." >&2; exit 1; }
+
+rm -rf out; mkdir -p out/classes out/dex out/gen/com/ansub/tvhome
+{
+  echo "package com.ansub.tvhome;"
+  echo "final class Apps { static final String[] LIST = {"
+  grep -v '^[[:space:]]*#' "${APPS:-apps.txt}" | tr -d ' \t\r' | grep -v '^$' | sed 's/.*/    "&",/'
+  echo "}; }"
+} > out/gen/com/ansub/tvhome/Apps.java
+
+"$BT/aapt2.exe" link -o out/base.apk -I "$JAR" --manifest AndroidManifest.xml --min-sdk-version 21 --target-sdk-version 34
+# The ":" separator is right: Git Bash turns it into ";" for javac.
+javac -nowarn -Xlint:-options -encoding UTF-8 -source 1.8 -target 1.8 -bootclasspath "$JAR:$BT/core-lambda-stubs.jar" \
+  -d out/classes $(find src out/gen -name "*.java")
+java -cp "$BT/lib/d8.jar" com.android.tools.r8.D8 --min-api 21 --release --lib "$JAR" --output out/dex \
+  $(find out/classes -name '*.class')
+py -I -c "import shutil,zipfile;shutil.copy('out/base.apk','out/unsigned.apk');z=zipfile.ZipFile('out/unsigned.apk','a');z.write('out/dex/classes.dex','classes.dex');z.close()"
+"$BT/zipalign.exe" -f 4 out/unsigned.apk out/aligned.apk
+
+# A signing key is made on first build. Keep key.jks: updates must be signed with the same key.
+KS=${KEYSTORE:-key.jks}; PASS=${KEYSTORE_PASS:-tvhome123}
+[ -f "$KS" ] || keytool -genkeypair -keystore "$KS" -storepass "$PASS" -keypass "$PASS" -alias tvhome \
+  -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=tvhome" >/dev/null 2>&1
+java -jar "$BT/lib/apksigner.jar" sign --ks "$KS" --ks-pass "pass:$PASS" --out out/tvhome.apk out/aligned.apk
+echo "Built out/tvhome.apk"
