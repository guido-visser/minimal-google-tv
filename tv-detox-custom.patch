index 0000000..a6af08e
--- /dev/null
+++ b/src/com/ansub/tvhome/FadeDream.java
@@ -0,0 +1,80 @@
+package com.ansub.tvhome;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.graphics.PixelFormat;
+import android.graphics.drawable.ColorDrawable;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.service.dreams.DreamService;
+import android.view.View;
+
+// The screen saver: instead of the TV going dark without warning, whatever is on screen (a paused
+// show, the home screen) fades to black over 30 seconds, then the TV goes to sleep. Any key before
+// that brings it straight back. install.sh makes this the screen saver, starting at the TV's own
+// screen saver time, with sleep 30 seconds later as a backstop.
+public class FadeDream extends DreamService {
+
+    static final long FADE_MS = 30000;
+
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private View shade;
+    private long start;
+
+    @Override
+    public void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        setInteractive(false);
+        setFullscreen(true);
+        // Android gives a screen saver an opaque black window; make it see-through so the show stays visible.
+        getWindow().setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+        getWindow().setFormat(PixelFormat.TRANSLUCENT);
+        // Android 11+ runs a screen saver in an activity that hides the one under it; let that one show through.
+        if (Build.VERSION.SDK_INT >= 30 && getWindow().getContext() instanceof Activity) {
+            ((Activity) getWindow().getContext()).setTranslucent(true);
+        }
+        shade = new View(this);
+        shade.setBackgroundColor(Color.BLACK);
+        shade.setAlpha(0f);
+        setContentView(shade);
+    }
+
+    @Override
+    public void onDreamingStarted() {
+        super.onDreamingStarted();
+        // A screen saver doesn't pass window changes on (Android 11), so hand the see-through format over directly.
+        getWindow().setFormat(PixelFormat.TRANSLUCENT);
+        try {
+            getWindow().getWindowManager().updateViewLayout(getWindow().getDecorView(), getWindow().getAttributes());
+        } catch (RuntimeException ignored) {
+        }
+        start = SystemClock.uptimeMillis();
+        // Stepped by hand: animations are turned off on these TVs, which would make an animator jump.
+        handler.post(step);
+    }
+
+    private final Runnable step = new Runnable() {
+        @Override public void run() {
+            float t = Math.min(1f, (SystemClock.uptimeMillis() - start) / (float) FADE_MS);
+            shade.setAlpha(t);
+            if (t < 1f) { handler.postDelayed(this, 50); return; }
+            // Ending the screen saver on its own puts the TV to sleep. With sleep set to Never, stay black.
+            if (Settings.Secure.getInt(getContentResolver(), "sleep_timeout", 0) >= 0) finish();
+        }
+    };
+
+    @Override
+    public void onDreamingStopped() {
+        handler.removeCallbacks(step);
+        super.onDreamingStopped();
+    }
+
+    @Override
+    public void onDetachedFromWindow() {
+        handler.removeCallbacks(step);
+        super.onDetachedFromWindow();
+    }
+}
